<Window x:Class="ImageMark.PresetSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ExportTitle}"
        Width="360" Height="420"
        MinWidth="300" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource ExportSelectPrompt}"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <CheckBox x:Name="chkSelectAll" Grid.Row="1" Content="{DynamicResource SelectAll}"
                  IsChecked="True" Margin="0,0,0,6"
                  Checked="ChkSelectAll_Changed" Unchecked="ChkSelectAll_Changed"/>

        <ListBox x:Name="lstPresets" Grid.Row="2"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Content="{Binding Name}" Margin="2"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource OK}" MinWidth="80" Padding="10,5"
                    Margin="0,0,6,0" IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="{DynamicResource Cancel}" MinWidth="80" Padding="10,5"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
