    <sys:String x:Key="ExportSelectPrompt">Wähle die zu exportierenden Presets aus:</sys:String>
    <sys:String x:Key="SelectAll">Alle auswählen</sys:String>
    <sys:String x:Key="OK">OK</sys:String>
    <sys:String x:Key="Cancel">Abbrechen</sys:String>
    <sys:String x:Key="MsgNoPresetSelected">Wähle mindestens ein Preset aus!</sys:String>
    <sys:String x:Key="NewPresetName">Neues Preset</sys:String>

</ResourceDictionary>
