<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:String x:Key="AppTitle">ImageMark – Vízjelező</x:String>

    <x:String x:Key="Images">Képek</x:String>
