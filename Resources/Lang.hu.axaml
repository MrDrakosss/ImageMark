    <x:String x:Key="LogoEditTip">Az előnézeten húzd a logót a helyére, a sarkainál fogva méretezd. Az áthelyezés csak az adott képre vonatkozik.</x:String>
    <x:String x:Key="ResetLogo">Vissza a preset szerinti helyre</x:String>
    <x:String x:Key="SelectLogoTitle">Logó kiválasztása</x:String>
    <x:String x:Key="MsgNothingEnabled">Kapcsold be a vízjelet vagy a logót!</x:String>
    <x:String x:Key="MsgNoLogoImage">A logó presethez nincs kép kiválasztva!</x:String>
    <x:String x:Key="MsgLogoLoadFailed">A logó nem tölthető be: {0}</x:String>

    <x:String x:Key="TextLabel">Szöveg</x:String>
