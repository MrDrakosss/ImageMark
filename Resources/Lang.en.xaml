<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="AppTitle">ImageMark – Watermark Tool</sys:String>

    <sys:String x:Key="Images">Images</sys:String>
    <sys:String x:Key="AddImages">➕ Add images…</sys:String>
    <sys:String x:Key="Remove">Remove</sys:String>
    <sys:String x:Key="ClearList">Clear list</sys:String>
    <sys:String x:Key="DragTip">Tip: you can also drag images here from File Explorer.</sys:String>

    <sys:String x:Key="Preview">Preview</sys:String>
    <sys:String x:Key="PreviewHint">Add images on the left&#10;to see the watermark preview here.</sys:String>

    <sys:String x:Key="Preset">Preset</sys:String>
    <sys:String x:Key="PresetName">Preset name</sys:String>
    <sys:String x:Key="SavePreset">💾 Save</sys:String>
    <sys:String x:Key="NewPreset">➕ New</sys:String>
    <sys:String x:Key="DeletePreset">🗑 Delete</sys:String>
    <sys:String x:Key="ExportPresets">⬆ Export…</sys:String>
    <sys:String x:Key="ImportPresets">⬇ Import…</sys:String>

    <sys:String x:Key="WatermarkSettings">Watermark settings</sys:String>
    <sys:String x:Key="TextLabel">Text</sys:String>
    <sys:String x:Key="Font">Font</sys:String>
    <sys:String x:Key="Bold">Bold</sys:String>
    <sys:String x:Key="Italic">Italic</sys:String>
    <sys:String x:Key="FontSize">Font size (% of image width)</sys:String>
    <sys:String x:Key="Opacity">Opacity</sys:String>
    <sys:String x:Key="Angle">Angle</sys:String>
    <sys:String x:Key="Color">Color</sys:String>
    <sys:String x:Key="ColorTooltip">Hex color code, e.g. #9E9E9E</sys:String>
    <sys:String x:Key="HSpacing">Horizontal spacing</sys:String>
    <sys:String x:Key="VSpacing">Vertical spacing</sys:String>
    <sys:String x:Key="Stagger">Offset rows (brick pattern)</sys:String>

    <sys:String x:Key="Output">Output</sys:String>
    <sys:String x:Key="OutputFolder">Output folder</sys:String>
    <sys:String x:Key="OutputTooltip">If left empty, images are saved next to the originals with a "_watermark" suffix.</sys:String>
    <sys:String x:Key="Browse">Browse…</sys:String>
    <sys:String x:Key="Format">Format</sys:String>
    <sys:String x:Key="OriginalFormat">Original format</sys:String>
    <sys:String x:Key="JpegQuality">JPEG quality</sys:String>

    <sys:String x:Key="Apply">✔ Apply watermark to images</sys:String>
    <sys:String x:Key="OpenFolder">📂 Open output folder</sys:String>
    <sys:String x:Key="Ready">Ready.</sys:String>

    <sys:String x:Key="SelectImagesTitle">Select images</sys:String>
    <sys:String x:Key="ImagesFilter">Image files|*.jpg;*.jpeg;*.png;*.bmp;*.tif;*.tiff|All files|*.*</sys:String>
    <sys:String x:Key="SelectOutputTitle">Select output folder</sys:String>
    <sys:String x:Key="ExportTitle">Export presets</sys:String>
    <sys:String x:Key="ImportTitle">Import presets</sys:String>
    <sys:String x:Key="PresetFileFilter">Preset files (*.json)|*.json|All files|*.*</sys:String>

    <sys:String x:Key="StatusAdded">{0} image(s) added, {1} in total.</sys:String>
    <sys:String x:Key="StatusNoneAdded">No new images were added (only image files are supported).</sys:String>
    <sys:String x:Key="StatusPresetSaved">Preset "{0}" saved.</sys:String>
    <sys:String x:Key="StatusPresetCreated">Preset "{0}" created.</sys:String>
    <sys:String x:Key="MsgNamePreset">Please give the preset a name!</sys:String>
    <sys:String x:Key="MsgConfirmDelete">Are you sure you want to delete the preset "{0}"?</sys:String>
    <sys:String x:Key="MsgAddImagesFirst">Add some images to the list on the left first!</sys:String>
    <sys:String x:Key="MsgEmptyText">The watermark text cannot be empty!</sys:String>
    <sys:String x:Key="StatusProcessing">Processing: {0}/{1}…</sys:String>
    <sys:String x:Key="StatusDone">Done! {0} image(s) watermarked.</sys:String>
    <sys:String x:Key="StatusDoneErrors">Done: {0} succeeded, {1} failed.</sys:String>
    <sys:String x:Key="MsgErrorsHeader">Errors occurred with the following images:</sys:String>
    <sys:String x:Key="StatusPreviewError">Preview error: {0}</sys:String>
    <sys:String x:Key="StatusExported">{0} preset(s) exported.</sys:String>
    <sys:String x:Key="StatusImported">{0} preset(s) imported.</sys:String>
    <sys:String x:Key="MsgImportFailed">Import failed: {0}</sys:String>
    <sys:String x:Key="DefaultPresetName">Default</sys:String>
    <sys:String x:Key="ExportSelectPrompt">Select the presets you want to export:</sys:String>
    <sys:String x:Key="SelectAll">Select all</sys:String>
    <sys:String x:Key="OK">OK</sys:String>
    <sys:String x:Key="Cancel">Cancel</sys:String>
    <sys:String x:Key="MsgNoPresetSelected">Select at least one preset!</sys:String>
    <sys:String x:Key="NewPresetName">New preset</sys:String>

</ResourceDictionary>
